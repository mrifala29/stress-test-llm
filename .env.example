# LLM API Configuration
LLM_BASE_URL=https://llm.linkit360.ai/v1/chat/completions
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=Qwen3.6-35B-A3B

# Target GPU Profile (a6000 or h200)
TARGET_GPU=h200

# Server-dev SSH
SSH_HOST=server-dev
SSH_USER=your_ssh_username
SSH_PASS=your_ssh_password_here

# Grafana / Prometheus
GRAFANA_URL=https://grafana.linkit360.ai
GRAFANA_USER=admin
GRAFANA_PASS=your_grafana_password_here
PROMETHEUS_REMOTE_WRITE_URL=http://<PROMETHEUS_HOST>:9600/api/v1/push
