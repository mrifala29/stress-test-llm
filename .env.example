# ==========================================
# 1. RUNPOD INSTANCE (RTX A6000 Ada - 48GB GDDR6)
# ==========================================
LLM_RUNPOD_URL=https://llm-runpod.linkit360.ai/v1/chat/completions
LLM_RUNPOD_API_KEY=your_runpod_api_key_here

# ==========================================
# 2. SERVER DGX INSTANCE (High-VRAM HBM)
# ==========================================
LLM_DGX_URL=https://llm-dgx.linkit360.ai/v1/chat/completions
LLM_DGX_API_KEY=your_dgx_api_key_here

# ==========================================
# Konfigurasi Model
# ==========================================
LLM_MODEL=Qwen3.6-35B-A3B

# ==========================================
# Prometheus Live Metrics (Streaming ke Grafana)
# ==========================================
PROMETHEUS_REMOTE_WRITE_URL=http://<PROMETHEUS_HOST>:9600/api/v1/push
